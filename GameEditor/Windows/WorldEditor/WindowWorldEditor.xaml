<Window x:Class="GameEditor.Windows.WorldEditor.WindowWorldEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows.WorldEditor"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - WorldEditor" 
        Height="450" 
        Width="800"
        Background="#202020"
        ThemeMode="Dark"
        AllowsTransparency="False">

    <Grid Name="Grid_Main">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <TabControl Grid.Row="0">
            <TabItem Header="Project">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_Save"
                                    Content="Save"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_Save_Click"/>
                            
                            <Button Name="Btn_WorldMap"
                                    Content="World Map"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_WorldMap_Click"/>
                            
                            <ComboBox Name="ComboBox_AddTexture"
                                      Padding="10,5,10,5"
                                      Margin="0,0,5,0"
                                      SelectionChanged="ComboBox_AddTexture_SelectionChanged">

                                <ComboBoxItem Tag="DEFAULT"
                                              Content="Add Texture"
                                              Visibility="Collapsed"
                                              Selector.IsSelected="True"/>

                                <ComboBoxItem Tag="TILE"
                                              Content="Tile"/>

                                <ComboBoxItem Tag="PROP"
                                              Content="Prop"/>

                                <ComboBoxItem Tag="PLAYER"
                                              Content="Player"/>

                            </ComboBox>

                            <ComboBox Name="ComboBox_ViewTextures"
                                      Padding="10,5,10,5"
                                      Margin="0,0,5,0" SelectionChanged="ComboBox_ViewTextures_SelectionChanged">

                                <ComboBoxItem Tag="DEFAULT"
                                              Content="Textures Details"
                                              Visibility="Collapsed"
                                              Selector.IsSelected="True"/>

                                <ComboBoxItem Tag="TILE"
                                              Content="Tiles"/>

                                <ComboBoxItem Tag="PROP"
                                              Content="Props"/>

                                <ComboBoxItem Tag="PLAYER"
                                              Content="Player"/>

                            </ComboBox>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Display">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Name="StckPanel_DisplayTile"
                                        Orientation="Vertical"
                                        Grid.Column="0"/>

                            <StackPanel Name="StckPanel_DisplayProps"
                                        Orientation="Vertical"
                                        Grid.Column="1"/>

                            <StackPanel Name="StckPanel_DisplayEntities"
                                        Orientation="Vertical"
                                        Grid.Column="2"/>

                            <StackPanel Name="StckPanel_DisplayPlayer"
                                        Orientation="Vertical"
                                        Grid.Column="3"/>

                        </Grid>

                    </Border>

                </Grid>
            </TabItem>
            <TabItem Header="Level">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_InitializeTiles"
                                    Content="Initialize Tiles"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_InitializeTiles_Click" />

                            <Button Name="Btn_ViewLevel"
                                    Content="Details"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" Click="Btn_ViewLevel_Click"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Tile">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_DrawTile"
                                    Content="Draw"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_DrawTile_Click"/>

                            <Button Name="Btn_InspectTile"
                                    Content="Inspect"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0"
                                    Click="Btn_InspectTile_Click"/>

                            <Button Name="Btn_EditTile"
                                    Content="Edit"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0"
                                    Click="Btn_EditTile_Click"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Props">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_AddProp"
                                    Content="Add"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0"
                                    Click="Btn_AddProp_Click"/>

                            <Button Name="Btn_InspectProp"
                                    Content="Inspect"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0"
                                    Click="Btn_InspectProp_Click"/>

                            <Button Name="Btn_EditProp"
                                    Content="Edit"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0"
                                    Click="Btn_EditProp_Click"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Entities">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_AddEntity"
                                    Content="Add"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_AddEntity_Click"/>

                            <Button Name="Btn_InspectEntity"
                                    Content="Inspect"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_InspectEntity_Click"/>

                            <Button Name="Btn_EditEntity"
                                    Content="Edit"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_EditEntity_Click"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Player">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_ViewPlayer"
                                    Content="Inspect"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_ViewPlayer_Click"/>

                            <Button Name="Btn_EditPlayer"
                                    Content="Edit"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_EditPlayer_Click"/>

                            <Button Name="Btn_ControlPlayer"
                                    Content="Control"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_ControlPlayer_Click"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>


        <Grid Name="Grid_Content" 
              Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SFML Render Area -->
            <Border BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Column="0"
                    Grid.Row="0">

                <WindowsFormsHost x:Name="SfmlHost"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>

            </Border>

            <GridSplitter HorizontalAlignment="Left"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          Background="#202020"
                          Width="5"
                          ShowsPreview="False"/>

            <!-- Selected nav item elements -->
            <Border Name="ToolbarContainer"
                    BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Column="1"
                    Margin="5,0,0,0">

            </Border>

        </Grid>




    </Grid>

</Window>
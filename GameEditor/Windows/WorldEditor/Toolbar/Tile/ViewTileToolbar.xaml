<UserControl x:Class="GameEditor.Windows.WorldEditor.Toolbar.Tile.ViewTileToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditor.Windows.WorldEditor.Toolbar.Tile"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="400"
             d:Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Tile Details"
               Grid.Row="0"
               Margin="10,5,10,5"/>

        <ScrollViewer Name="ScrollViewer_Details"
                      Grid.Row="1"
                      Margin="10"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">

            <StackPanel Orientation="Vertical">

                <!-- ID -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="ID : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_ID"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>

                </Grid>

                <!-- Type -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Type : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_Type"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Grid Index -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Grid Index : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_GridIndex"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Render Positions -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Render Position : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_RenderPosition"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Render Size -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Render Size : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_RenderSize"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- Texture file -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Texture : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_TextureName"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>

                </Grid>

                <!-- Texture path -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Texture path : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_TexturePath"
                             Grid.Column="1"
                             Margin="10,5,10,5"
                             IsEnabled="False"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Stretch"/>
                </Grid>
                
                <!-- Texture preview -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Texture Preview : "
                           Grid.Column="0"
                           Margin="10,5,10,5"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"/>

                    <Image Name="Img_Texture"
                           Grid.Column="1"
                           Margin="10,5,10,5"
                           Width="128"
                           Height="128"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Left"/>
                </Grid>

            </StackPanel>

        </ScrollViewer>

    </Grid>
</UserControl>

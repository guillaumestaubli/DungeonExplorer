<Window x:Class="GameEditor.Windows.Texture.ViewTexture.WindowViewPropTextures"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows.Texture.ViewTexture"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - View Prop Textures" 
        Height="450" 
        Width="800"
        ThemeMode="Dark">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="Prop Textures"
               Grid.Row="0"
               Grid.Column="0"
               HorizontalAlignment="Left"
               VerticalAlignment="Center"
               FontSize="28"
               FontWeight="Bold"
               Margin="10"/>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="0"
                      Margin="10"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">

            <StackPanel Name="StackPanel_List"
                        Orientation="Vertical">


            </StackPanel>

        </ScrollViewer>

        <Grid Grid.Row="1"
              Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Label Content="Texture preview : "
                   Grid.Row="0"
                   Margin="10,10,10,10"/>

            <Image Name="Img_Texture"
                   Grid.Row="1"
                   Margin="10"
                   VerticalAlignment="Stretch"
                   HorizontalAlignment="Stretch"/>

        </Grid>

    </Grid>
</Window>

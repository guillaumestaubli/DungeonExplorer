<Window x:Class="GameEditor.Windows.WindowAddPropTexture"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows"
        mc:Ignorable="d"
        Title="WindowAddPropTexture" 
        Height="450" 
        Width="800"
        ThemeMode="Dark">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Name="Lbl_Title"
               Content="Add new prop textures"
               Grid.Row="0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               FontSize="20"
               FontWeight="Bold"
               Margin="10,10,10,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Button Name="Btn_Browse"
                    Content="Browse"
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="10,10,10,0"
                    HorizontalAlignment="Stretch"
                    Click="Btn_Browse_Click"/>

            <ListBox Name="ListBox_Files"
                     Grid.Row="1"
                     Grid.Column="0"
                     Margin="10,10,10,0"
                     VerticalAlignment="Stretch"
                     HorizontalAlignment="Stretch" 
                     SelectionChanged="ListBox_Files_SelectionChanged"/>

            <Border BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="10,10,10,0">

                <Image Name="Img_File"
                       VerticalAlignment="Stretch"
                       HorizontalAlignment="Stretch"/>

            </Border>

            <Button Name="Btn_Validate"
                    Content="Validate"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="10,10,10,10"
                    HorizontalAlignment="Stretch"
                    Click="Btn_Validate_Click"/>

        </Grid>
        
    </Grid>
</Window>

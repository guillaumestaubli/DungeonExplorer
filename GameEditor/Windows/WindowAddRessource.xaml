<Window x:Class="GameEditor.Windows.WindowAddRessource"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - Add Texture" 
        Height="450" 
        Width="800"
        ThemeMode="Dark">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Name="Lbl_Title"
               Content="Add new textures"
               Grid.Row="0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               FontSize="20"
               FontWeight="Bold"
               Margin="10,10,10,10"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Button Name="Btn_Browse"
                        Content="Select files"
                        Grid.Row="0"
                        Width="auto"
                        HorizontalAlignment="Stretch"
                        Margin="10,0,10,0" Click="Btn_Browse_Click"/>

                <ListBox Name="LstBox_Files"
                         Grid.Row="1"
                         Margin="10"
                         SelectionMode="Single"
                         d:ItemsSource="{d:SampleData ItemCount=25}" SelectionChanged="LstBox_Files_SelectionChanged"/>
            </Grid>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0"
                           Content="Texture Category : "
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                    <ComboBox Name="ComboBox_TextureCategory"
                              Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              Margin="10,0,10,0"
                              VerticalAlignment="Center" SelectionChanged="ComboBox_TextureCategory_SelectionChanged"/>

                </Grid>

                <Border BorderBrush="#C2C2C2"
                        Background="#282828"
                        BorderThickness="1"
                        Grid.Row="1"
                        Margin="10,10,10,0">

                    <Image Name="Img_Texture"
                           HorizontalAlignment="Stretch" 
                           VerticalAlignment="Stretch"/>

                </Border>

                <Button Name="Btn_Validate"
                        Content="Add textures to project"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        Margin="10" Click="Btn_Validate_Click"/>

            </Grid>


        </Grid>
        
    </Grid>
</Window>

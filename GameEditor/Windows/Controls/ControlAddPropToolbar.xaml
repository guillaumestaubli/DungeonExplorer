<UserControl x:Class="GameEditor.Windows.Controls.ControlAddPropToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditor.Windows.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Add prop"
               Grid.Row="0"
               Margin="10,5,10,5"/>

        <ScrollViewer Name="ScrollViewer_Texture"
                      Grid.Row="1"
                      Margin="10"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <WrapPanel Name="WrapPanel_Textures"/>

        </ScrollViewer>
    </Grid>
</UserControl>

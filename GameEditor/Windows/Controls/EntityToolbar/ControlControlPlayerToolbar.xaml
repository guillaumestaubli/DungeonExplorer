<UserControl x:Class="GameEditor.Windows.Controls.EntityToolbar.ControlControlPlayerToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditor.Windows.Controls.EntityToolbar"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="400"
             d:Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Label Content="Player control"
               Grid.Row="0"
               Margin="10,5,10,5"/>

        <ScrollViewer Name="ScrollViewerDetails"
                      Grid.Row="1"
                      Margin="10"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch">

            <StackPanel Orientation="Vertical">

                <!-- ID -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="ID : "
                            Grid.Column="0"
                            Margin="10,5,10,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_ID"
                              Grid.Column="1"
                              Margin="10,5,10,5"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- DIRECTION -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Direction : "
                            Grid.Column="0"
                            Margin="10,5,10,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_Direction"
                              Grid.Column="1"
                              Margin="10,5,10,5"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- ACTION -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Action : "
                            Grid.Column="0"
                            Margin="10,5,10,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_Action"
                              Grid.Column="1"
                              Margin="10,5,10,5"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- RENDER POSITION -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Render position : "
                            Grid.Column="0"
                            Margin="10,5,10,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_RenderPosition"
                              Grid.Column="1"
                              Margin="10,5,10,5"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- RENDER SIZE -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Render size : "
                            Grid.Column="0"
                            Margin="10,5,10,5"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"/>

                    <TextBox Name="TxtBox_RenderSize"
                              Grid.Column="1"
                              Margin="10,5,10,5"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Stretch"/>
                </Grid>

                <!-- TEXTURE PREVIEW -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Label Content="Texture Preview : "
                            Grid.Column="0"
                            Margin="10,5,10,5"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"/>

                    <Image Name="Img_Texture"
                            Grid.Column="1"
                            Margin="10,5,10,5"
                            Width="128"
                            Height="128"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left"/>
                </Grid>

            </StackPanel>
            
        </ScrollViewer>
    </Grid>
</UserControl>

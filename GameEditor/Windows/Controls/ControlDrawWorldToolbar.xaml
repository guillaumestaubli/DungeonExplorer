<UserControl x:Class="GameEditor.Windows.Controls.ControlDrawWorldToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GameEditor.Windows.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" 
             d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Type : "
                   Grid.Column="0"
                   Margin="10"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Left"/>

            <ComboBox Name="ComboBox_Type"
                      Grid.Column="1"
                      Margin="10" SelectionChanged="ComboBox_Type_SelectionChanged"/>

        </Grid>

        <WrapPanel Name="WrapPanel_Textures"
                   Grid.Row="1"
                   Margin="10">
            
            
        </WrapPanel>

    </Grid>
</UserControl>

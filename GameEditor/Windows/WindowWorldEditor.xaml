<Window x:Class="GameEditor.Windows.WindowWorldEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - WorldEditor" 
        Height="450" 
        Width="800"
        ThemeMode="System">

    <Grid Name="Grid_Main">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <StackPanel Orientation="Horizontal"
                    Grid.Column="0"
                    Grid.Row="0">
            
            
            
        </StackPanel>
        
        
        <Grid Name="Grid_Content" 
              Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SFML Render Area -->
            <Border BorderBrush="#C2C2C2" 
                    BorderThickness="1"
                    Grid.Column="0"
                    Grid.Row="0">

                <WindowsFormsHost x:Name="SfmlHost"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>

            </Border>
                
            <GridSplitter HorizontalAlignment="Left"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          Background="#202020"
                          Width="5"
                          ShowsPreview="True"/>

            <!-- Selected nav item elements -->
            <Border BorderBrush="#C2C2C2" 
                    BorderThickness="1"
                    Grid.Column="1"
                    Margin="5,0,0,0">

                <Canvas Name="Canvas_SettingsContainer"
                        Margin="0,0,0,0"
                        VerticalAlignment="Stretch"
                        HorizontalAlignment="Stretch"
                        Background="#282828">

                    
                    
                </Canvas>

            </Border>

        </Grid>

        <Canvas Name="Canvas_SettingsTabsContainer"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Margin="0"
                Background="#202020">
            
            
            
        </Canvas>

    </Grid>

</Window>
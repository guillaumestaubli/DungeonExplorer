<Window x:Class="GameEditor.Windows.WindowWorldEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - WorldEditor" 
        Height="450" 
        Width="800"
        Background="#202020"
        ThemeMode="System">

    <Grid Name="Grid_Main">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <TabControl Grid.Row="0">
            <TabItem Header="File">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_Save"
                                    Content="Save"
                                    Padding="20,5,20,5"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Display">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Name="StckPanel_DisplayTile"
                                        Orientation="Vertical"
                                        Grid.Column="0"/>

                            <StackPanel Name="StckPanel_DisplayProps"
                                        Orientation="Vertical"
                                        Grid.Column="1"/>

                            <StackPanel Name="StckPanel_DisplayEntities"
                                        Orientation="Vertical"
                                        Grid.Column="2"/>

                            <StackPanel Name="StckPanel_DisplayPlayer"
                                        Orientation="Vertical"
                                        Grid.Column="3"/>

                        </Grid>
                        
                    </Border>
                    
                </Grid>
            </TabItem>
            <TabItem Header="Textures">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            
                            
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="World">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Props">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Entities">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Player">
                <Grid Background="#202020">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>


        <Grid Name="Grid_Content" 
              Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SFML Render Area -->
            <Border BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Column="0"
                    Grid.Row="0">

                <WindowsFormsHost x:Name="SfmlHost"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>

            </Border>
                
            <GridSplitter HorizontalAlignment="Left"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          Background="#202020"
                          Width="5"
                          ShowsPreview="True"/>

            <!-- Selected nav item elements -->
            <Border BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Column="1"
                    Margin="5,0,0,0">

            </Border>

        </Grid>
        



    </Grid>

</Window>
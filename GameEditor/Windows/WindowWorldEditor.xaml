<Window x:Class="GameEditor.Windows.WindowWorldEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - WorldEditor" 
        Height="450" 
        Width="800"
        Background="#202020"
        ThemeMode="Dark">

    <Grid Name="Grid_Main">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Navigation -->
        <TabControl Grid.Row="0">
            <TabItem Header="Project">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_Save"
                                    Content="Save"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_Save_Click"/>

                            <Button Name="Btn_AddTileTextures"
                                    Content="Add Tile Textures"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_AddTileTextures_Click"/>

                            <Button Name="Btn_AddPropTextures"
                                    Content="Add Prop Textures"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_AddPropTextures_Click"/>

                            <Button Name="Btn_InitializeTiles"
                                    Content="Initialize Tiles"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_InitializeTiles_Click" />

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Display">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Name="StckPanel_DisplayTile"
                                        Orientation="Vertical"
                                        Grid.Column="0"/>

                            <StackPanel Name="StckPanel_DisplayProps"
                                        Orientation="Vertical"
                                        Grid.Column="1"/>

                            <StackPanel Name="StckPanel_DisplayEntities"
                                        Orientation="Vertical"
                                        Grid.Column="2"/>

                            <StackPanel Name="StckPanel_DisplayPlayer"
                                        Orientation="Vertical"
                                        Grid.Column="3"/>

                        </Grid>

                    </Border>

                </Grid>
            </TabItem>
            <TabItem Header="World">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_EditWorldSize"
                                    Content="Edit Size"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_EditWorldSize_Click"/>

                            <Button Name="Btn_DrawWorld"
                                    Content="Draw"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0" 
                                    Click="Btn_DrawWorld_Click"/>

                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Tile">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Props">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">

                            <Button Name="Btn_AddProp"
                                    Content="Add prop"
                                    Padding="10,5,10,5"
                                    Margin="0,0,5,0"
                                    Click="Btn_AddProp_Click"/>


                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Entities">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Player">
                <Grid Background="#282828">
                    <Border Margin="5"
                            BorderBrush="Transparent"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal">



                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>


        <Grid Name="Grid_Content" 
              Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SFML Render Area -->
            <Border BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Column="0"
                    Grid.Row="0">

                <WindowsFormsHost x:Name="SfmlHost"
                                    VerticalAlignment="Stretch"
                                    HorizontalAlignment="Stretch"/>

            </Border>

            <GridSplitter HorizontalAlignment="Left"
                          Grid.Column="1"
                          VerticalAlignment="Stretch"
                          Background="#202020"
                          Width="5"
                          ShowsPreview="False"/>

            <!-- Selected nav item elements -->
            <Border Name="ToolbarContainer"
                    BorderBrush="#C2C2C2"
                    Background="#282828"
                    BorderThickness="1"
                    Grid.Column="1"
                    Margin="5,0,0,0">

            </Border>

        </Grid>




    </Grid>

</Window>
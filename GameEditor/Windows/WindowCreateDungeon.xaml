<Window x:Class="GameEditor.Windows.WindowCreateDungeon"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameEditor.Windows"
        mc:Ignorable="d"
        Title="DungeonExplorer - GameEditor - CreateDungeon"
        Height="400"
        Width="800"
        ThemeMode="Dark">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Label Name="Lbl_Title"
               Content="Dungeon Explorer - Project creation"
               Grid.Row="0"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               FontSize="36"
               FontWeight="Bold"
               Margin="20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Label Name="Lbl_Name"
                   Content="Project name : "
                   Grid.Row="0"
                   Grid.Column="0"
                   Margin="5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

            <TextBox Name="TxtBox_Name"
                     Grid.Row="0"
                     Grid.Column="1"
                     Margin="5"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Left"
                     Width="250"/>

            <Label Name="Lbl_Dir"
                   Content="Directory : "
                   Grid.Row="1"
                   Grid.Column="0"
                   Margin="5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="1"
                        Grid.Column="1">

                <TextBox Name="TxtBox_Dir"
                         Margin="5,5,0,5"
                         VerticalAlignment="Center"
                         Width="350"
                         IsEnabled="False"/>

                <Button Name="Btn_Browse"
                        Content="Browse"
                        VerticalAlignment="Center" 
                        Click="Btn_Browse_Click"/>

            </StackPanel>

            <Label Name="Lbl_FirstLevelSize"
                   Content="First level size : "
                   Grid.Row="2"
                   Grid.Column="0"
                   Margin="5"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"/>

            <StackPanel Orientation="Horizontal"
                        Grid.Row="2"
                        Grid.Column="1">

                <Label Content="X : "
                       Margin="5,5,5,5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

                <TextBox Name="TxtBox_Level_X"
                         Margin="0,5,5,5"
                         VerticalAlignment="Center"
                         Width="100"
                         Text="0"
                         PreviewTextInput="TxtBox_Validation_Number_Integer"/>

                <Label Content="Y : "
                       Margin="5,5,5,5"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>

                <TextBox Name="TxtBox_Level_Y"
                         Margin="0,5,5,5"
                         VerticalAlignment="Center"
                         Width="100"
                         Text="0"
                         PreviewTextInput="TxtBox_Validation_Number_Integer"/>

            </StackPanel>

        </Grid>

        <Border Grid.Row="2"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                BorderBrush="#C2C2C2"
                BorderThickness="1"
                Margin="0,10,0,0"/>

        <StackPanel Orientation="Horizontal"
                    Grid.Row="2"
                    Margin="0,20,0,0">
            
            <Button Name="BtnCancel"
                    Content="Cancel"
                    Width="150"
                    Margin="10" 
                    Click="BtnCancel_Click"/>

            <Button Name="Btn_Validate"
                    Content="Validate"
                    Width="150"
                    Margin="10" 
                    Click="Btn_Validate_Click"/>

        </StackPanel>

    </Grid>
</Window>
